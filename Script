-- ===== [ NHÁNH 1: CẤU HÌNH BIẾN & DỮ LIỆU ] =====
local defaultGuiUrl = "https://raw.githubusercontent.com/hacolord/gui/refs/heads/main/gui"

local keyTable = {
    ["TRACKER"] = "https://api.jnkie.com/api/v1/luascripts/public/343e855d45503c954284ddde7a2abf6d2373135a87a4d1b310a244c40daec3c2/download",
    ["VOID"]    = "https://api.jnkie.com/api/v1/luascripts/public/f60d14811f882fbf6fb72382834cc4f762a85313884813a4c495a8e96702d446/download",
    ["TP"]      = "https://api.jnkie.com/api/v1/luascripts/public/88f064d48ad2706982cae18c5177722a812b93dcaef9648609ce5fdfe00a55e5/download",
    ["AVOID"]   = "https://api.jnkie.com/api/v1/luascripts/public/fabc4e6277700e9ea5c10f18854f6f9d93b511763786b6deb7c5c30dee5346ac/download"
}

-- ===== [ NHÁNH 2: TẠO GIAO DIỆN NHẬP KEY NHỎ GỌN (RAYFIELD) ] =====
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Tạo Window nhỏ gọn bằng kích thước Loading Title
local KeyWindow = Rayfield:CreateWindow({
   Name = "Key System",
   LoadingTitle = "Jnkie Verification",
   LoadingSubtitle = "Nhập key để tiếp tục",
   ConfigurationSaving = { Enabled = false },
   Discord = { Enabled = false },
   KeySystem = false
})

local KeyTab = KeyWindow:CreateTab("Xác Thực Key", 4483362458)

local tempInputKey = ""

KeyTab:CreateInput({
   Name = "Nhập Key Jnkie",
   PlaceholderText = "Dán key của bạn vào đây...",
   RemoveTextOnFocus = false,
   Callback = function(Text)
       tempInputKey = Text
   end,
})

-- ===== [ NHÁNH 3: HÀM KIỂM TRA KEY VÀ TẢI LOGIC JNKIE ] =====
local function safeLoadJnkie(name, url)
    local maxRetries = 2
    for i = 1, maxRetries do
        local success, response = pcall(function()
            -- Đảm bảo truyền Key chuẩn xác vào bộ nhớ trước khi tải
            return game:HttpGet(url)
        end)

        if success and type(response) == "string" and #response > 20 then
            -- Tải và thực thi đoạn code trả về từ Jnkie
            local func, loadErr = loadstring(response)
            if func then
                local execSuccess, execErr = pcall(func)
                if execSuccess then
                    print("[Jnkie Loaded Successfully]: " .. name)
                    return true
                else
                    warn("[Jnkie Exec Error - " .. name .. "]: " .. tostring(execErr))
                end
            else
                warn("[Jnkie Loadstring Compile Error - " .. name .. "]: " .. tostring(loadErr))
            end
        else
            warn("[Jnkie Download Failed / Invalid Response - " .. name .. "] Lần thử " .. i .. "/" .. maxRetries)
        end
        
        task.wait(0.5)
    end
    return false
end

-- ===== [ NHÁNH 4: XỬ LÝ KÍCH HOẠT VÀ HỦY GUI NHẬP KEY ] =====
KeyTab:CreateButton({
   Name = "Kiểm Tra & Kích Hoạt",
   Callback = function()
       -- Xử lý cắt khoảng trắng thừa ở 2 đầu Key
       local cleanKey = string.gsub(tempInputKey, "^%s*(.-)%s*$", "%1")

       if cleanKey == "" then
           Rayfield:Notify({Title = "Lỗi", Content = "Vui lòng nhập Key trước!", Duration = 3})
           return
       end

       Rayfield:Notify({Title = "Đang kiểm tra...", Content = "Đang kết nối đến server Jnkie...", Duration = 2})

       -- Gán Key chính xác vào môi trường toàn cục
       getgenv().SCRIPT_KEY = cleanKey

       -- Thử tải trước 1 URL của Jnkie để xác nhận Key đúng
       local isKeyValid = safeLoadJnkie("TRACKER", keyTable["TRACKER"])

       if isKeyValid then
           Rayfield:Notify({Title = "Thành công!", Content = "Key hợp lệ, đang mở Gui...", Duration = 2})
           
           -- 1. HỦY / XÓA GUI NHẬP KEY ĐỂ TRÁNH ĐÈ GIAO DIỆN
           task.wait(0.5)
           Rayfield:Destroy()

           -- 2. TẢI CÁC URL JNKIE CÒN LẠI
           task.spawn(function()
               safeLoadJnkie("VOID", keyTable["VOID"])
               task.wait(0.3)
               safeLoadJnkie("TP", keyTable["TP"])
               task.wait(0.3)
               safeLoadJnkie("AVOID", keyTable["AVOID"])
           end)

           -- 3. CHỈ KHỞI ĐỘNG GUI GITHUB KHI KEY ĐÃ ĐÚNG VÀ CÁC NGUYÊN NGUỒN CƠ BẢN ĐÃ KÍCH HOẠT
           task.spawn(function()
               local guiSuccess, guiErr = pcall(function()
                   loadstring(game:HttpGet(defaultGuiUrl))()
               end)
               if not guiSuccess then
                   warn("[GUI Github Error]: " .. tostring(guiErr))
               end
           end)

       else
           Rayfield:Notify({Title = "Xác thực thất bại", Content = "Key không đúng hoặc đã hết hạn!", Duration = 3})
       end
   end,
})
